{
  "expo": {
    "name": "Dawood Trader",
    "slug": "dawood-trader",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Item ki tasweer lene ke liye camera istemal hoga",
        "NSPhotoLibraryUsageDescription": "Item ki tasweer chunne ke liye gallery istemal hogi"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a56db",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Dawood Trader",
      "shortName": "DT",
      "lang": "en",
      "description": "Pakistan's Premier Distribution, Inventory & Billing Management System",
      "themeColor": "#2563eb",
      "backgroundColor": "#f1f5f9",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Item ki tasweer chunne ke liye gallery access chahiye",
          "cameraPermission": "Item ki tasweer lene ke liye camera access chahiye"
        }
      ]
    ]
  }
}
